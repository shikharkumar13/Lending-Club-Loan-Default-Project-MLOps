# Data files are versioned by DVC, never by git.
# The small .dvc pointer files (and DVC's own .gitignore files) MUST be
# committed: they are how git records which data version belongs to a commit.
artifacts/
data/**
!artifacts/
data/**/
!artifacts/
data/**/*.dvc
!artifacts/
data/**/.gitignore
*.parquet
*.csv
!docs/*.csv

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Notebooks
.ipynb_checkpoints/

# MLflow / DVC local state
mlruns/
mlartifacts/
mlflow.db
/.dvc/cache
/.dvc/tmp

# OS
.DS_Store
/models
