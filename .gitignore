# Data files are versioned by DVC, never by git.
# The small .dvc pointer files (and DVC's own .gitignore files) MUST be
# committed: they are how git records which data version belongs to a commit.
artifacts/
data/**
!artifacts/
data/**/
!artifacts/
data/**/*.dvc
!artifacts/
data/**/.gitignore
*.parquet
*.csv
!docs/*.csv

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Notebooks
.ipynb_checkpoints/

# MLflow / DVC local state
mlruns/
mlartifacts/
mlflow.db
/.dvc/cache
/.dvc/tmp

# Evidently HTML reports: megabytes each, regenerated by `dvc repro drift`.
reports/monitoring/html/

# Local agent / editor state. Nothing here is part of the project, and some of
# it records machine-specific paths, so it must never reach a public remote.
.claude/
CLAUDE.md
AGENTS.md
.cursor/
.aider*
.vscode/
.idea/

# OS
.DS_Store
/models
